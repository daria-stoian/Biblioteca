# Copiaza in "server/.env". Utilizatorul, parola si portul trebuie sa fie aceleasi ca in ../.env
DATABASE_URL="postgresql://biblioweb:schimba_parola@localhost:5432/biblioweb?schema=public"

# Portul API-ului si adresa frontend-ului React (pentru CORS)
PORT=3000
CLIENT_URL=http://localhost:5173

# Autentificare JWT (RN-01). Genereaza o cheie cu:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=schimba_cu_o_cheie_lunga_si_aleatoare
JWT_EXPIRES_IN=8h

# Contul de administrator creat de scriptul seed (npm run db:seed)
ADMIN_EMAIL=admin@biblioweb.ro
ADMIN_PASSWORD=schimba_parola_admin
ADMIN_NAME=Administrator
