@page
@model LoginModel
@{
    ViewData["Title"] = "Autentificare";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div style="display:flex; justify-content:center; align-items:center; min-height:60vh;">
    <div class="form-container" style="width:100%; max-width:420px;">
        <div style="text-align:center; margin-bottom:25px;">
            <p style="font-size:2.5em; margin:0;">📚</p>
            <h2 style="margin:8px 0 4px 0;">Bun venit înapoi!</h2>
            <p style="color:#7f8c8d; font-size:0.9em;">Conectează-te la contul tău BiblioWeb</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var eroare in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>❌ @eroare.ErrorMessage</div>
                }
            </div>
        }

        <form id="account" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="form-control"
                       placeholder="exemplu@email.com" autofocus />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Password">Parolă</label>
                <input asp-for="Input.Password" type="password" class="form-control"
                       placeholder="Parolă" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:20px; font-size:0.9em;">
                <input asp-for="Input.RememberMe" type="checkbox" />
                <label asp-for="Input.RememberMe" style="margin:0;">Ține-mă minte</label>
            </div>
            <button type="submit" class="btn" style="width:100%; padding:12px;">
                🔐 Conectează-te
            </button>
        </form>

        <div style="text-align:center; margin-top:20px; color:#7f8c8d; font-size:0.9em;">
            Nu ai cont?
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl"
               style="color:#9b30d9; font-weight:600;">Înregistrează-te</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
