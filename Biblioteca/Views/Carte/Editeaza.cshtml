@model Biblioteca.Models.Carte

@{
    ViewData["Title"] = "Editează carte";
}

<div class="page-header">
    <h2>✏️ Editează: @Model.Titlu</h2>
    <a href="/Carte/Detalii/@Model.Id_Carte" class="btn btn-outline">← Înapoi</a>
</div>

<div class="form-container">
    <form method="post" asp-action="Editeaza" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id_Carte" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-group">
            <label asp-for="Titlu">Titlu *</label>
            <input asp-for="Titlu" class="form-control" />
            <span asp-validation-for="Titlu" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Id_Autor">Autor *</label>
            <select asp-for="Id_Autor" class="form-control" asp-items="ViewBag.Id_Autor">
                <option value="">-- Selectează autor --</option>
            </select>
        </div>

        <div class="form-group">
            <label asp-for="Id_Categorie">Categorie *</label>
            <select asp-for="Id_Categorie" class="form-control" asp-items="ViewBag.Id_Categorie">
                <option value="">-- Selectează categorie --</option>
            </select>
        </div>

        <div class="form-group">
            <label asp-for="ISBN">ISBN</label>
            <input asp-for="ISBN" class="form-control" />
        </div>

        <div style="display:flex; gap:15px;">
            <div class="form-group" style="flex:1;">
                <label asp-for="An_Publicare">An publicare</label>
                <input asp-for="An_Publicare" type="number" class="form-control" />
            </div>
            <div class="form-group" style="flex:1;">
                <label asp-for="Numar_Pagini">Număr pagini</label>
                <input asp-for="Numar_Pagini" type="number" class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Descriere">Descriere</label>
            <textarea asp-for="Descriere" class="form-control" rows="4"></textarea>
        </div>

        <div class="form-group">
            @if (!string.IsNullOrEmpty(Model.Imagine_Coperta))
            {
                <p style="font-size:0.9em; color:#7f8c8d; margin-bottom:8px;">Imagine curentă:</p>
                <img src="~/imagini/@Model.Imagine_Coperta"
                     style="max-height:120px; border-radius:6px; margin-bottom:10px; display:block;" />
            }
            <label for="imagine">Imagine nouă <small style="color:#7f8c8d;">(lasă gol pentru a păstra cea existentă)</small></label>
            <input type="file" name="imagine" id="imagine" class="form-control"
                   accept="image/jpeg,image/png,image/webp" />
        </div>

        <div style="display:flex; gap:10px; margin-top:25px;">
            <button type="submit" class="btn">💾 Salvează modificările</button>
            <a href="/Carte/Detalii/@Model.Id_Carte" class="btn btn-outline">Anulează</a>
        </div>
    </form>
</div>
