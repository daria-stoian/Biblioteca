@model IEnumerable<Biblioteca.Models.Recenzie>

@{
    ViewData["Title"] = "Recenzii";
}

<h2>⭐ Părerile Cititorilor</h2>

<div style="display:flex; gap:30px; flex-wrap:wrap; margin-top:20px; align-items:flex-start;">

    <div class="form-container" style="flex:1; min-width:280px; margin:0;">
        <h3 style="margin-bottom:20px;">Scrie o recenzie</h3>
        <p style="color:#7f8c8d; margin-bottom:20px;">
            Ai citit o carte și vrei să împărtășești părerea ta cu alți cititori?
        </p>
        <a href="/Recenzie/Adauga" class="btn" style="width:100%; text-align:center; display:block;">
            📝 Scrie o recenzie
        </a>
    </div>

    <div style="flex:1; min-width:280px;">
        @if (!Model.Any())
        {
            <div style="text-align:center; padding:40px; color:#7f8c8d;">
                <p style="font-size:2em; margin-bottom:10px;">💬</p>
                <p>Nicio recenzie publicată încă. Fii primul!</p>
            </div>
        }
        else
        {
            @foreach (var r in Model)
            {
                <div class="list-item" style="flex-direction:column; align-items:flex-start; margin-bottom:12px;">
                    <div style="display:flex; justify-content:space-between; width:100%; align-items:flex-start;">
                        <div>
                            <h4 style="color:#f39c12; margin-bottom:3px;">
                                @for (int i = 0; i < r.Nota; i++)
                                {
                                    <text>⭐</text>
                                }
                                &nbsp;@r.Carte?.Titlu
                            </h4>
                            <p style="font-size:0.82em; color:#7f8c8d;">
                                @r.Utilizator?.Nume_Complet · @r.Data_Postare.ToString("dd MMM yyyy")
                            </p>
                        </div>
                        @if (r.Id_Utilizator == 1)
                        {
                            <form method="post" action="/Recenzie/Sterge" style="display:inline; flex-shrink:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id_Recenzie" />
                                <button type="submit" class="btn btn-danger"
                                        style="padding:4px 10px; font-size:0.8em;"
                                        onclick="return confirm('Ștergi recenzia?')">
                                    ✕
                                </button>
                            </form>
                        }
                    </div>
                    <p style="margin-top:8px; line-height:1.5;">@r.Comentariu</p>
                </div>
            }
        }
    </div>
</div>