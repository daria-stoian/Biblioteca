@model Biblioteca.Models.Recenzie

@{
    ViewData["Title"] = "Scrie o recenzie";
}

<div class="page-header">
    <h2>⭐ Scrie o recenzie</h2>
    <a href="/Recenzie" class="btn btn-outline">← Înapoi</a>
</div>

<div class="form-container">
    <form method="post" asp-action="Adauga">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id_Utilizator" value="1" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-group">
            <label asp-for="Id_Carte">Cartea *</label>
            <select asp-for="Id_Carte" class="form-control" asp-items="ViewBag.Id_Carte" required>
                <option value="">-- Selectează cartea împrumutată --</option>
            </select>
            <small style="color:#7f8c8d;">Poți recenza doar cărțile pe care le-ai împrumutat.</small>
            <span asp-validation-for="Id_Carte" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Nota">Nota ta (1-5) *</label>
            <select asp-for="Nota" class="form-control">
                <option value="5">⭐⭐⭐⭐⭐ Excelentă</option>
                <option value="4">⭐⭐⭐⭐ Foarte bună</option>
                <option value="3">⭐⭐⭐ Bună</option>
                <option value="2">⭐⭐ Slabă</option>
                <option value="1">⭐ Nu o recomand</option>
            </select>
        </div>

        <div class="form-group">
            <label asp-for="Comentariu">Recenzia ta</label>
            <textarea asp-for="Comentariu" class="form-control" rows="5"
                      placeholder="Spune-ne ce ai gândit despre această carte..."></textarea>
        </div>

        <div style="display:flex; gap:10px; margin-top:20px;">
            <button type="submit" class="btn">📝 Publică recenzia</button>
            <a href="/Recenzie" class="btn btn-outline">Anulează</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
