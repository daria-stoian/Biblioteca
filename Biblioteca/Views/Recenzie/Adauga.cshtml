@model Biblioteca.Models.Recenzie

@{
    ViewData["Title"] = "Scrie o recenzie";
}

<div class="page-header">
    <h2>⭐ Scrie o recenzie</h2>
    <a href="/Recenzie" class="btn btn-outline">← Înapoi</a>
</div>

<div class="form-container">
    <form method="post" asp-action="Adauga">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id_Utilizator" value="1" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-group">
            <label asp-for="Id_Carte">Cartea *</label>

            @* Camp de cautare vizibil — filtreaza optiunile din select *@
            <input type="text" id="cautareCarteRecenzie"
                   class="form-control"
                   placeholder="Scrie titlul sau autorul pentru a căuta..."
                   autocomplete="off"
                   style="margin-bottom: 6px;" />

            <select asp-for="Id_Carte" id="selectCarteRecenzie"
                    class="form-control" asp-items="ViewBag.Id_Carte" required>
                <option value="">-- Selectează cartea --</option>
            </select>

            <small style="color:#7f8c8d;">
                Scrie câteva litere pentru a filtra lista de cărți.
            </small>
            <span asp-validation-for="Id_Carte" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Nota">Nota ta *</label>
            <select asp-for="Nota" class="form-control">
                <option value="5">⭐⭐⭐⭐⭐ - Excelentă</option>
                <option value="4">⭐⭐⭐⭐ - Foarte bună</option>
                <option value="3">⭐⭐⭐ - Bună</option>
                <option value="2">⭐⭐ - Slabă</option>
                <option value="1">⭐ - Nu o recomand</option>
            </select>
        </div>

        <div class="form-group">
            <label asp-for="Comentariu">Recenzia ta</label>
            <textarea asp-for="Comentariu" class="form-control" rows="5"
                      placeholder="Spune-ne ce ai gândit despre această carte..."></textarea>
        </div>

        <div style="display:flex; gap:10px; margin-top:20px;">
            <button type="submit" class="btn">📝 Publică recenzia</button>
            <a href="/Recenzie" class="btn btn-outline">Anulează</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const cautare = document.getElementById('cautareCarteRecenzie');
        const select = document.getElementById('selectCarteRecenzie');

        // Salvam toate optiunile originale la incarcare pagina
        const toateOptiunile = Array.from(select.options);

        cautare.addEventListener('input', function () {
            const termen = this.value.toLowerCase().trim();
            const valoareSelectata = select.value;

            // Golim si re-populam cu optiunile care se potrivesc
            select.innerHTML = '';
            toateOptiunile.forEach(opt => {
                if (termen === '' || opt.text.toLowerCase().includes(termen)) {
                    select.appendChild(opt.cloneNode(true));
                }
            });

            // Pastram selectia daca optiunea e inca vizibila
            if (valoareSelectata) {
                select.value = valoareSelectata;
            }

            // Daca ramane o singura optiune valida, o selectam automat
            if (select.options.length === 2 && termen !== '') {
                select.selectedIndex = 1;
            }
        });
    </script>
}
