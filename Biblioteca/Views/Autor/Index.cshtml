@model IEnumerable<Biblioteca.Models.Autor>

@{
    ViewData["Title"] = "Autori";
}

<div class="page-header">
    <h2>✍️ Autori</h2>
    @if (User.IsInRole("Administrator"))
    {
        <a href="/Autor/Adauga" class="btn">+ Adaugă autor</a>
    }
</div>

<form method="get" action="/Autor" style="margin-bottom:20px; display:flex; gap:10px;">
    <input type="text" name="cautare" value="@ViewBag.Cautare"
           class="form-control" placeholder="Caută după nume..."
           style="max-width:300px;" />
    <button type="submit" class="btn">🔍 Caută</button>
    @if (!string.IsNullOrEmpty(ViewBag.Cautare as string))
    {
        <a href="/Autor" class="btn btn-outline">✕ Resetează</a>
    }
</form>

@if (!Model.Any())
{
    <div style="text-align:center; padding:50px; color:#7f8c8d;">
        <p style="font-size:3em; margin-bottom:10px;">✍️</p>
        <p style="margin-bottom:15px;">Niciun autor găsit.</p>
        @if (User.IsInRole("Administrator"))
        {
            <a href="/Autor/Adauga" class="btn">+ Adaugă primul autor</a>
        }
    </div>
}
else
{
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Autor</th>
                    <th>Biografie (preview)</th>
                    <th>Acțiuni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var autor in Model)
                {
                    <tr>
                        <td>
                            <a href="/Autor/Detalii/@autor.Id_Autor" style="color:#6a0dad; font-weight:bold; text-decoration:none;">
                                @autor.Nume_Autor
                            </a>
                        </td>
                        <td style="color:#7f8c8d; font-size:0.88em; max-width:300px;
                            overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                            @(autor.Biografie?.Length > 90 ? autor.Biografie[..90] + "…" : autor.Biografie ?? "—")
                        </td>
                        <td>
                            <div style="display:flex; gap:7px;">
                                <a href="/Autor/Detalii/@autor.Id_Autor" class="btn btn-outline" style="font-size:0.82em;">👁️ Detalii</a>
                                @if (User.IsInRole("Administrator"))
                                {
                                    <a href="/Autor/Editeaza/@autor.Id_Autor" class="btn btn-outline" style="font-size:0.82em;">✏️ Editează</a>
                                }
                                @if (User.IsInRole("Administrator"))
                                {
                                    <a href="/Autor/Sterge/@autor.Id_Autor" class="btn btn-danger" style="font-size:0.82em;">🗑️ Șterge</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
