@model Biblioteca.Models.Autor

@{
    ViewData["Title"] = "Adaugă autor";
}

<div class="page-header">
    <h2>➕ Adaugă autor</h2>
    <a href="/Autor" class="btn btn-outline">← Înapoi</a>
</div>

<div class="form-container">
    <form method="post" asp-action="Adauga">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-group">
            <label asp-for="Nume_Autor">Nume autor *</label>
            <input asp-for="Nume_Autor" class="form-control" placeholder="Ex: Frank Herbert" />
            <span asp-validation-for="Nume_Autor" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Biografie">Biografie</label>
            <textarea asp-for="Biografie" class="form-control" rows="5"
                      placeholder="Câteva cuvinte despre autor..."></textarea>
        </div>
        <div style="display:flex; gap:10px; margin-top:20px;">
            <button type="submit" class="btn">💾 Salvează autorul</button>
            <a href="/Autor" class="btn btn-outline">Anulează</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}