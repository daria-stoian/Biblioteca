@{
    ViewData["Title"] = "Despre Noi";
}

<h2>ℹ️ Povestea BiblioWeb</h2>

<div class="details-container" style="flex-direction:column; text-align:center; max-width:800px; margin:0 auto;">
    <p class="lead" style="font-size:18px; font-weight:bold; margin-bottom:20px;">
        Am început din pasiune pentru lectură și am creat un spațiu digital unde oricine poate avea acces la cunoaștere.
    </p>
    <p>
        Proiectul nostru a luat naștere în 2026, cu scopul de a digitaliza procesul de împrumut al cărților
        și de a oferi o interfață modernă și ușor de folosit pentru toți cititorii.
    </p>
    <p style="margin-top:15px;">
        Echipa noastră lucrează zi de zi pentru a adăuga noi titluri în catalog și pentru a organiza
        evenimente literare care să unească pasionații de carte.
    </p>

    <div style="display:flex; gap:20px; justify-content:center; margin-top:40px; flex-wrap:wrap;">
        <div style="background:white; padding:25px; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,0.07); min-width:160px;">
            <p style="font-size:2.5em; margin:0;">📚</p>
            <h3 id="nr-carti" style="font-size:2em; color:#750e87; margin:5px 0;">@ViewBag.NrCarti</h3>
            <p style="color:#7f8c8d;">Cărți în catalog</p>
        </div>
        <div style="background:white; padding:25px; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,0.07); min-width:160px;">
            <p style="font-size:2.5em; margin:0;">👥</p>
            <h3 style="font-size:2em; color:#750e87; margin:5px 0;">1</h3>
            <p style="color:#7f8c8d;">Cititori activi</p>
        </div>
        <div style="background:white; padding:25px; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,0.07); min-width:160px;">
            <p style="font-size:2.5em; margin:0;">📅</p>
            <h3 style="font-size:2em; color:#750e87; margin:5px 0;">2026</h3>
            <p style="color:#7f8c8d;">Anul înființării</p>
        </div>
    </div>

    <div style="margin-top:40px;">
        <a href="/Contact" class="btn" style="margin-right:10px;">✉️ Contactează-ne</a>
        <a href="/Carte" class="btn btn-outline">📚 Explorează catalogul</a>
    </div>
</div>
